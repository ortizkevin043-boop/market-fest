<!DOCTYPE html>
<html>
<head>
    <title>Lenovo Market Fest</title>
    <style>
        body {
            background-image: Url('fondo.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            min-height: 100vh;
        }
        body {
            font-family: Arial, sans-serif;
            color: white;
            text-align: center;
        }
        canvas {
            border: 2px solid #333;
            margin-top: 20px;
        }
        button {
            padding: 10px 20px;
            font-size: 16px;
            background-color: #fc0000;
            color: white;
            border: none;
            cursor: pointer;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <h1>Lenovo Market Fest</h1>
    <p>Haz clic en las cajas para descubir tu Premio!</p>
    <canvas id="gameCanvas" width="1050" height="850"></canvas>
    <P><button id="resetBtn">Reiniciar Juego</button><col>   </col><button id="OpenBtn">Abrir Cajas</button></P>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const resetButton = document.getElementById('resetBtn');
        const openButton = document.getElementById('OpenBtn');
         
        // Lista de items posibles que pueden aparecer
        const possibleItems = [
            "Gif $50",
            "GiF $50",
            "GIF $50",
            "GIF $50",
            "GiF $100",
            "GIF $100",
            "Monitor 24",
            "Maleta",
            "Headset",
            "Descuento 2%",
            "Descuento 5%",
            "Descuento 10%",
            "Descuento 15%",
            "Gif $50",
            "GiF $50",
            "GIF $50",
            "GIF $50",
            "GiF $100",
            "GIF $100",
            "Monitor 24",
            "Maleta",
            "Headset",
            "GIF $50",
            "GIF $100",
            "Monitor 24"
        ];


        // Función para seleccionar 12 items únicos aleatorios
        function getUniqueRandomItems() {
            // Hacemos una copia de la lista para no modificar el original
            const shuffled = [...possibleItems].sort(() => 0.5 - Math.random());
            return [
                shuffled[0], // Primer item aleatorio
                shuffled[1], // Primer item aleatorio
                shuffled[2], // Primer item aleatorio
                shuffled[3], // Primer item aleatorio
                shuffled[4], // Primer item aleatorio
                shuffled[5], // Primer item aleatorio
                shuffled[6], // Primer item aleatorio
                shuffled[7], // Primer item aleatorio
                shuffled[8], // Primer item aleatorio
                shuffled[9], // Primer item aleatorio
                shuffled[10], // Primer item aleatorio
                shuffled[11], // Primer item aleatorio
                shuffled[12], // Primer item aleatorio
                shuffled[13], // Primer item aleatorio
                shuffled[14], // Primer item aleatorio
                shuffled[15], // Primer item aleatorio
                shuffled[16], // Primer item aleatorio
                shuffled[17], // Primer item aleatorio
                shuffled[18], // Primer item aleatorio
                shuffled[19], // Primer item aleatorio
                shuffled[20], // Primer item aleatorio
                shuffled[21], // Primer item aleatorio
                shuffled[22], // Primer item aleatorio
                shuffled[23], // Primer item aleatorio
                shuffled[24] // Primer item aleatorio
            ];
        }

         // Función para seleccionar un item aleatorio de la lista
        function getRandomItem() {
            const randomIndex = Math.floor(Math.random() * possibleItems.length);
            return possibleItems[randomIndex];
        }
        
        const uniqueItems = getUniqueRandomItems();
        
    
        // Definir cajas (#,posicion, tamaño, estado, contenido)
        let boxes = [
            { n:1, x: 50, y: 50, width: 150, height: 120, opened: false, content: uniqueItems[0] },
            { n:2, x: 250, y: 50, width: 150, height: 120, opened: false, content: uniqueItems[1] },
            { n:3, x: 450, y: 50, width: 150, height: 120, opened: false, content: uniqueItems[2] },
            { n:4, x: 650, y: 50, width: 150, height: 120, opened: false, content: uniqueItems[3] },
            { n:5, x: 850, y: 50, width: 150, height: 120, opened: false, content: uniqueItems[4] },
            { n:6, x: 50, y: 200, width: 150, height: 120, opened: false, content: uniqueItems[5] },
            { n:7, x: 250, y: 200, width: 150, height: 120, opened: false, content: uniqueItems[6] },
            { n:8, x: 450, y: 200, width: 150, height: 120, opened: false, content: uniqueItems[7] },
            { n:9, x: 650, y: 200, width: 150, height: 120, opened: false, content: uniqueItems[8] },
            { n:10, x: 850, y: 200, width: 150, height: 120, opened: false, content: uniqueItems[9]},
            { n:11, x: 50, y: 350, width: 150, height: 120, opened: false, content: uniqueItems[10] },
            { n:12, x: 250, y: 350, width: 150, height: 120, opened: false, content: uniqueItems[11] },
            { n:13, x: 450, y: 350, width: 150, height: 120, opened: false, content: uniqueItems[12] },
            { n:14, x: 650, y: 350, width: 150, height: 120, opened: false, content: uniqueItems[13] },
            { n:15, x: 850, y: 350, width: 150, height: 120, opened: false, content: uniqueItems[14] },
            { n:16, x: 50, y: 500, width: 150, height: 120, opened: false, content: uniqueItems[15] },
            { n:17, x: 250, y: 500, width: 150, height: 120, opened: false, content: uniqueItems[16] },
            { n:18, x: 450, y: 500, width: 150, height: 120, opened: false, content: uniqueItems[17] },
            { n:19, x: 650, y: 500, width: 150, height: 120, opened: false, content: uniqueItems[18] },
            { n:20, x: 850, y: 500, width: 150, height: 120, opened: false, content: uniqueItems[19] },
            { n:21, x: 50, y: 650, width: 150, height: 120, opened: false, content: uniqueItems[20] },
            { n:22, x: 250, y: 650, width: 150, height: 120, opened: false, content: uniqueItems[21]},
            { n:23, x: 450, y: 650, width: 150, height: 120, opened: false, content: uniqueItems[22] },
            { n:24, x: 650, y: 650, width: 150, height: 120, opened: false, content: uniqueItems[23] },
            { n:25, x: 850, y: 650, width: 150, height: 120, opened: false, content: uniqueItems[24] }
        ];
         
        
        
        // Dibujar todas las cajas
        function drawBoxes() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            boxes.forEach(box => {
                // Dibujar la caja (cuerpo)
                ctx.fillStyle = '#E42022'; // Rojo
                ctx.fillRect(box.x, box.y + 20, box.width, box.height - 20); // Altura sin tapa

                if (!box.opened) {
                    // Dibujar la tapa de la caja
                    //ctx.fillStyle = '#A0522D'; // Marrón claro
                    //ctx.fillRect(box.x, box.y, box.width, 20);

                    // Dibujar el asa de la caja
                    ctx.fillStyle = '#E42022';
                    ctx.fillRect(box.x + box.width - 30, box.y - 10, 20, 10);
                } else {
                    // Mostrar contenido cuando está abierta
                    ctx.fillStyle = 'White'; // Dorado para el fondo del contenido
                    ctx.fillRect(box.x + 5, box.y + 30, box.width - 10, box.height - 40);

                    // Texto del contenido
                    ctx.fillStyle = 'Red';
                    ctx.font = '18px Arial';
                    const textWidth = ctx.measureText(box.content).width;
                    ctx.fillText(box.content,
                                box.x + (box.width - textWidth) / 2,
                                box.y + 80);
                }

                // Dibujar el borde de la caja
                ctx.strokeStyle = '#000';
                ctx.lineWidth = 2;
                ctx.strokeRect(box.x, box.y, box.width, box.height);

                // Texto "Abrir" si está cerrada
                if (!box.opened) {
                    ctx.fillStyle = 'White';
                    ctx.font = '44px Arial';
                    const textWidth = ctx.measureText('Abrir').width;
                    ctx.fillText(box.n,
                                box.x + 60,
                                box.y + 95);
                }
            });
        }

        // Verificar si se hizo clic en una caja
        canvas.addEventListener('click', (event) => {
            const rect = canvas.getBoundingClientRect();
            const mouseX = event.clientX - rect.left;
            const mouseY = event.clientY - rect.top;

            boxes.forEach(box => {
                if (!box.opened &&
                    mouseX >= box.x && mouseX <= box.x + box.width &&
                    mouseY >= box.y && mouseY <= box.y + box.height) {
                    box.opened = true;
                    drawBoxes();
                }
            });
        });

        // Reiniciar el juego
        resetButton.addEventListener('click', () => {
            href=window.location.href = window.location.href
            //boxes.forEach(box => {
            //box.opened = false;
            //});
            //drawBoxes();
        });

          // Abrir Cajas
        openButton.addEventListener('click', () => {
            boxes.forEach(box => {
                box.opened = true;
            });
            drawBoxes();
        });


        // Dibujar las cajas iniciales
        drawBoxes();
    </script>
</body>
</html>
